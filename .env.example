# ============================================================
# FreeTAKServer Production Config
# Copy to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# Your Tailscale IP — get it with: tailscale ip -4
# install.sh auto-detects and updates this if left as placeholder
FTS_IP=100.x.x.x

# ── OPTIONAL ─────────────────────────────────────────────────────────────────

# Password used for all .p12 certificate files (TAK clients must enter this on import)
# Default 'atakatak' is the well-known TAK ecosystem default; change for production
CERT_PASSWORD=atakatak

# User cert validity in days (default 365 = 1 year)
USER_CERT_VALIDITY_DAYS=365

# Space-separated list of users to provision on first install
# Example: INITIAL_USERS=admin pilot1 pilot2
INITIAL_USERS=

# Connection message shown to TAK clients on connect
FTS_CONNECTION_MESSAGE=Connected to FreeTAKServer

# Log level: debug | info | warning | error
FTS_LOG_LEVEL=info

# Host path where FTS persists data (certs, DB, packages)
DATA_DIR=/opt/fts

# ── Ports ────────────────────────────────────────────────────────────────────

COT_PORT=8087
SSL_COT_PORT=8089
API_PORT=19023
UI_PORT=5000

# ── AUTO-GENERATED BY `make init` — do not edit manually ─────────────────────
FTS_WEBSOCKET_KEY=
FTS_SECRET_KEY=
FTS_FED_PASSWORD=
FTS_API_KEY=
