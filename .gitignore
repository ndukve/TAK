# Secrets — never commit
.env
takserver.env
dev.env

# Local dev environment runtime state (dev.sh)
.dev-api.pid
.dev-api.log

# Backup output (DB dumps, certs, secrets) — never commit
backups/

# Generated user packages
packages/*.zip
!packages/.gitkeep

# Plugin APKs — licensed, do not redistribute via git
*.apk

# Your own tak.gov-downloaded TAK Server release ZIP — licensed, do not
# redistribute via git (see Dockerfile Stage 1 comment)
takserver-dist/*
!takserver-dist/.gitkeep

# Service cert output (make add-service)
certs/

# IDE
.idea/
*.iml

# macOS
.DS_Store

# Node dependencies / build output — installed by pnpm, built by vite,
# neither belongs in git (regenerated on every install/build)
node_modules/
admin/ui/dist/
admin/ui/.vite/
admin/ui/vite-dev.log

# Python bytecode cache
__pycache__/
*.pyc

# Offline install bundle (scripts/build steps regenerate this)
offline-bundle/

# Internal SDD planning docs (brainstorm/spec/plan) — not part of the shipped repo
docs/
